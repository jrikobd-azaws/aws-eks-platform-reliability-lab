
# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE
ARG UV_IMAGE
ARG RUNTIME_IMAGE=debian@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

FROM ${UV_IMAGE} AS uvbin

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uvbin /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/pyproject.toml

RUN uv sync --frozen --no-dev --package app --no-install-project

COPY backend/app backend/app
COPY backend/alembic.ini backend/alembic.ini

RUN uv sync --frozen --no-dev --package app

FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
       ca-certificates libssl3t64 libffi8 libsqlite3-0 \
       libbz2-1.0 liblzma5 libreadline8t64 \
       libncursesw6 libexpat1 zlib1g libgdbm6t64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local /usr/local
RUN rm -rf /usr/local/lib/python3.14/site-packages/pip \
    /usr/local/lib/python3.14/site-packages/pip-*.dist-info \
    /usr/local/lib/python3.14/site-packages/setuptools* \
    /usr/local/lib/python3.14/site-packages/msgpack* \
    /usr/local/lib/python3.14/ensurepip
RUN mkdir -p /etc/ssl/rds
COPY --chmod=0644 backend/certs/global-bundle.pem /etc/ssl/rds/global-bundle.pem
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/workspace/.venv/bin:${PATH}"

WORKDIR /workspace

COPY --from=builder /workspace/.venv /workspace/.venv
COPY --from=builder /workspace/backend /workspace/backend

RUN printf '%s\n' 'appuser:x:10001:10001:appuser:/home/appuser:/usr/sbin/nologin' >> /etc/passwd \
    && printf '%s\n' 'appuser:x:10001:' >> /etc/group \
    && mkdir -p /home/appuser \
    && chown -R 10001:10001 /workspace /home/appuser

USER 10001:10001

WORKDIR /workspace/backend

EXPOSE 8000

CMD ["fastapi", "run", "--host", "0.0.0.0", "--port", "8000"]
